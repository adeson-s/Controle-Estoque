# ─── Controle de Estoque — Configuração ──────────────────────────────────────
# Copie este arquivo para .env e preencha com suas credenciais.
#
# O modo DEMO funciona sem nenhuma configuração.
# Acesse com: usuário "demo" / senha "demo123"
#
# Para usar com sua própria planilha Google Sheets:
# 1. Crie uma planilha no Google Sheets para cada filial
# 2. Gere uma API Key no Google Cloud Console
# 3. Crie um Google Apps Script e publique como Web App
# 4. Preencha as variáveis abaixo

# ── Google Sheets API ──────────────────────────────────────────────────────────
VITE_GOOGLE_API_KEY=
VITE_MASTER_SHEET_ID=
VITE_SCRIPT_URL=

# ── IDs das Planilhas por Filial ───────────────────────────────────────────────
VITE_SHEET_CENTRO=
VITE_SHEET_NORTE=
VITE_SHEET_SUL=
VITE_SHEET_LESTE=

# ── Configurações da Sessão ────────────────────────────────────────────────────
# Tempo de sessão em horas (logout automático por inatividade)
VITE_SESSION_HOURS=8
